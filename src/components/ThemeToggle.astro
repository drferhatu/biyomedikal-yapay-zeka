---
/**
 * Tema düğmesi: sade hilal ikonu. Açık temada çizgi hilal, koyu temada dolu hilal.
 * Varsayılan tema açıktır; seçim localStorage'da tutulur (ilk boyama: BaseLayout).
 */
interface Props { class?: string; }
const { class: className } = Astro.props;
---
<button type="button" class:list={['tt', className]} role="switch" aria-checked="false" aria-label="Koyu temaya geç" title="Koyu temaya geç">
  <svg class="tt-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
  </svg>
</button>

<style>
  .tt {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--color-line-2);
    border-radius: 8px;
    background: transparent;
    color: var(--color-ink-2);
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .tt:hover { border-color: var(--color-ink); color: var(--color-ink); }
  .tt-moon { transition: transform 0.45s cubic-bezier(0.65, 0, 0.35, 1), fill 0.3s ease; }

  /* En dar ekranlarda başlık tek satırda kalsın: düğme mobil menüye taşınır */
  @media (max-width: 384px) { .tt-header { display: none; } }
  :global(.tt-menu-row) { display: none; }
  @media (max-width: 384px) { :global(.tt-menu-row) { display: flex; } }

  /* Koyu tema: hilal dolar ve hafifçe döner */
  :global(html[data-theme='dark']) .tt { color: var(--color-ink); background: var(--color-paper-2); }
  :global(html[data-theme='dark']) .tt-moon { fill: currentColor; transform: rotate(-18deg); }

  @media (prefers-reduced-motion: reduce) { .tt-moon { transition: none; } }
</style>

<script>
  const root = document.documentElement;
  const toggles = Array.from(document.querySelectorAll<HTMLButtonElement>('.tt'));
  const themeMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const THEME_COLOR = { light: '#f5f7fb', dark: '#0b1220' } as const;

  const syncToggles = () => {
    const dark = root.dataset.theme === 'dark';
    const label = dark ? 'Açık temaya geç' : 'Koyu temaya geç';
    for (const t of toggles) {
      t.setAttribute('aria-checked', String(dark));
      t.setAttribute('aria-label', label);
      t.setAttribute('title', label);
    }
  };

  const applyTheme = (theme: 'light' | 'dark') => {
    if (theme === 'dark') root.dataset.theme = 'dark';
    else delete root.dataset.theme;
    themeMeta?.setAttribute('content', THEME_COLOR[theme]);
    try { localStorage.setItem('theme', theme); } catch {}
    syncToggles();
  };

  syncToggles();
  for (const toggle of toggles) {
    toggle.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const doc = document as Document & {
        startViewTransition?: (cb: () => void) => { ready: Promise<void>; finished: Promise<void> };
      };

      // Destekleyen tarayıcılarda yeni tema düğmeden dairesel olarak yayılır
      if (doc.startViewTransition && !reduce) {
        const r = toggle.getBoundingClientRect();
        const x = r.left + r.width / 2;
        const y = r.top + r.height / 2;
        const end = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
        root.classList.add('theme-vt');
        const vt = doc.startViewTransition(() => applyTheme(next));
        vt.ready
          .then(() => {
            root.animate(
              { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${end}px at ${x}px ${y}px)`] },
              { duration: 650, easing: 'cubic-bezier(0.65, 0, 0.35, 1)', fill: 'forwards', pseudoElement: '::view-transition-new(root)' },
            );
          })
          .catch(() => {});
        // Sınıf, geçiş tamamen bitene kadar kalmalı: erken kaldırılırsa tarayıcının varsayılan
        // çapraz geçişi devreye girip eski temayı bir anlığına geri gösterir
        vt.finished.finally(() => root.classList.remove('theme-vt'));
        return;
      }

      // Yedek: renkler kısa bir geçişle değişir
      if (!reduce) {
        root.classList.add('theme-anim');
        setTimeout(() => root.classList.remove('theme-anim'), 450);
      }
      applyTheme(next);
    });
  }
</script>
