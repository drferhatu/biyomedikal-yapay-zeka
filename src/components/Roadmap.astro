---
/**
 * Dönem haritası: tek yarıyıl, 5 modül, 14 hafta.
 * Modül şeridi + haftalık düğümler; her düğüm hafta sayfasına gider.
 */
import { modules, moduleColorVar, weekHref, scheduleOf, formatDate, type Week } from '@/lib/site';
interface Props { weeks: Week[]; }
const { weeks } = Astro.props;
const byNum = new Map(weeks.map((w) => [w.data.week, w]));
---
<ol class="relative space-y-12 border-l border-line pl-6 sm:pl-10">
  {modules.map((m, i) => (
    <li class="relative" id={m.slug} style={`--mod:${moduleColorVar(m)}`}>
      <span class="absolute -left-[calc(1.5rem+7px)] top-2 size-3.5 rounded-sm border-2 border-paper bg-[var(--mod)] ring-4 ring-[color-mix(in_srgb,var(--mod)_18%,transparent)] sm:-left-[calc(2.5rem+7px)]" aria-hidden="true"></span>
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--mod)]">Modül {i + 1}</span>
        <span class="font-mono text-[11px] text-ink-3">Hafta {m.weeks[0]}–{m.weeks[m.weeks.length - 1]}</span>
      </div>
      <h3 class="mt-1 font-display text-xl font-semibold text-ink md:text-2xl">{m.title}</h3>
      <p class="mt-1.5 max-w-2xl text-[15px] leading-relaxed text-ink-2">{m.summary}</p>

      <ul class="mt-5 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {m.weeks.map((n) => {
          const w = byNum.get(n);
          const s = scheduleOf(n);
          const d = formatDate(s?.date);
          const off = s && (s.status === 'tatil' || s.status === 'ertelendi');
          return (
            <li>
              <a href={weekHref(n)} class="group flex h-full items-start gap-3 rounded-xl border border-line bg-white p-3 transition-colors hover:border-[var(--mod)] focus-visible:outline-accent">
                <span class="grid size-8 shrink-0 place-items-center rounded-lg font-mono text-sm font-semibold text-white bg-[var(--mod)]">{String(n).padStart(2, '0')}</span>
                <span class="min-w-0">
                  <span class="block text-[13px] font-semibold leading-snug text-ink group-hover:text-brand">{w?.data.title ?? `Hafta ${n}`}</span>
                  <span class="mt-1 flex flex-wrap gap-x-2 font-mono text-[11px] text-ink-3">
                    {d && <span>{d}</span>}
                    {w?.data.exam && <span class="font-semibold text-[#c2410c]">Ara sınav</span>}
                    {off && <span class="font-semibold">{s!.status === 'tatil' ? 'Tatil' : 'Ertelendi'}</span>}
                    {w && w.data.methods.length > 0 && !w.data.exam && <span class="truncate">{w.data.methods.slice(0, 2).join(' · ')}</span>}
                  </span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </li>
  ))}
</ol>
