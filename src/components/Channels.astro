---
/** İletişim kanalları + karekodlar (yansıdan okutmak için). */
import { course, href } from '@/lib/site';
interface Props { compact?: boolean; title?: string; }
const { compact = false, title = 'İletişim kanalları' } = Astro.props;
const ICON: Record<string, string> = {
  instagram: 'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4z M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7z M17.5 6.5h.01',
  email: 'M4 6h16v12H4z M4 7l8 6 8-6',
  phone: 'M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2',
  calendar: 'M4 6h16v14H4z M4 10h16 M8 3v4 M16 3v4',
  office: 'M12 7v5l3 2 M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z',
};
const external = (u: string) => u.startsWith('http');
---
<section aria-labelledby="kanallar" class:list={['not-prose', compact ? '' : 'rounded-2xl border border-line bg-white p-6 shadow-soft']}>
  <div class="mb-5">
    <h2 id="kanallar" class="font-display text-2xl font-semibold text-ink">{title}</h2>
    {!compact && <p class="mt-1 text-sm text-ink-2">Karekodu telefonunuzla okutun ya da bağlantıya tıklayın. Instagram hesabını takip etmeniz önerilir; derse ve alana ilişkin faydalı içerikler oraya düşer.</p>}
  </div>
  <ul class:list={['grid gap-4', compact ? 'sm:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3']}>
    {course.channels.map((c) => (
      <li class="flex flex-col rounded-xl border border-line p-4">
        <div class="flex items-center gap-2.5">
          <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-brand-soft text-brand" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={ICON[c.id]} /></svg>
          </span>
          <h3 class="!mt-0 !mb-0 font-sans text-sm font-bold leading-snug text-ink">{c.name}</h3>
        </div>
        <p class="mt-2 text-xs leading-relaxed text-ink-2">{c.desc}</p>
        {!compact && <img src={href(`/qr/${c.id}.svg`)} alt={`${c.name} için karekod`} width="160" height="160" class="mx-auto mt-4 size-36 rounded-lg border border-line bg-white p-2" loading="lazy" />}
        <a href={c.url} target={external(c.url) ? '_blank' : undefined} rel={external(c.url) ? 'noopener' : undefined} class="mt-4 inline-flex items-center justify-center gap-1.5 rounded-lg bg-ink px-4 py-2 text-xs font-semibold !text-paper !no-underline hover:bg-brand hover:!text-paper">
          {c.cta} {external(c.url) && <span aria-hidden="true">↗</span>}
        </a>
      </li>
    ))}
  </ul>
</section>
