---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Roadmap from '@/components/Roadmap.astro';
import { modules, getWeeksSorted, href, course } from '@/lib/site';
const weeks = await getWeeksSorted();
---
<BaseLayout title="Ders Akışı" description={`14 haftalık ${course.title} dersinin modül bazında yol haritası.`}>
  <div class="wrap py-14 md:py-20">
    <SectionHeading eyebrow={`Ders Akışı · ${course.semester}`} title="Dönemin tamamı tek bakışta"
      lede="Ders tek yarıyıl ve beş modülden oluşur: biyomedikal veri temelleri, klasik makine öğrenmesi, sinyal analizi, derin öğrenme ve açıklanabilir–güvenilir yapay zeka. 8. hafta ara sınavdır." />
    <nav aria-label="Modüller" class="mt-10 flex flex-wrap gap-2">
      {modules.map((m, i) => (
        <a href={`#${m.slug}`} class="rounded-lg border border-line bg-white px-3 py-1.5 text-xs font-semibold text-ink-2 hover:border-ink hover:text-ink" style={`border-left: 3px solid var(--mod-${m.color})`}>{i + 1}. {m.short}</a>
      ))}
    </nav>
  </div>
  <div class="wrap pb-24">
    <Roadmap weeks={weeks} />
    <p class="mt-16 text-sm text-ink-3">Haftalık tarihler akademik takvime göre güncellenir. Bir hafta tatile denk gelirse veya ertelenirse bu sayfada ve ilgili haftanın sayfasında belirtilir. Kartlar görünümü için <a class="link" href={href('/haftalar')}>tüm haftalar</a> sayfasına bakabilirsiniz.</p>
  </div>
</BaseLayout>
