---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Toc from '@/components/Toc.astro';
import WeekPager from '@/components/WeekPager.astro';
import ModuleChip from '@/components/ModuleChip.astro';
import NotebookEmbed from '@/components/NotebookEmbed.astro';
import { render } from 'astro:content';
import { getWeeksSorted, moduleOf, moduleIndex, moduleColorVar, scheduleOf, formatDate, STATUS_LABEL, href, weekSlug, course } from '@/lib/site';

export async function getStaticPaths() {
  const weeks = await getWeeksSorted();
  return weeks.map((w, i) => ({
    params: { slug: weekSlug(w.data.week) },
    props: { week: w, prev: weeks[i - 1], next: weeks[i + 1] },
  }));
}
const { week, prev, next } = Astro.props;
const { Content, headings } = await render(week);
const m = moduleOf(week.data.module);
const s = scheduleOf(week.data.week);
const dateLong = formatDate(s?.date, true);
const statusLabel = s && s.status !== 'normal' && !week.data.exam ? STATUS_LABEL[s.status] : '';
const outcomes = course.outcomes.filter((o) => o.weeks.includes(week.data.week));
const tocExtra = [
  ...(week.data.objectives.length ? [{ slug: 'ogrenme-hedefleri', text: 'Öğrenme hedefleri' }] : []),
  ...(week.data.notebook ? [{ slug: 'defter', text: 'Uygulama defteri' }] : []),
];
const KIND_LABEL: Record<string, string> = { makale: 'Makale', kitap: 'Kitap', dokuman: 'Dokümantasyon', video: 'Video', diger: '' };
const pageTitle = `Hafta ${week.data.week} — ${week.data.title}`;
---
<BaseLayout title={pageTitle} description={week.data.description} ogType="article">
  <header class="border-b border-line" style={`--mod:${moduleColorVar(m)}`}>
    <div class="wrap py-12 md:py-16">
      <nav aria-label="Konum" class="flex flex-wrap items-center gap-2 text-sm text-ink-3">
        <a href={href('/haftalar')} class="hover:text-ink">Haftalar</a><span aria-hidden="true">/</span>
        <a href={href(`/ders-akisi#${m.slug}`)} class="hover:text-ink">Modül {moduleIndex(m)} · {m.title}</a>
      </nav>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <span class="grid h-12 min-w-12 place-items-center rounded-xl px-3 font-display text-2xl font-semibold text-white bg-[var(--mod)]">{String(week.data.week).padStart(2, '0')}</span>
        <ModuleChip module={m} size="md" />
        {dateLong && <span class="font-mono text-sm font-medium text-ink-2">{dateLong}</span>}
        {week.data.exam && <span class="rounded-md bg-[#fdebe0] px-2.5 py-1 text-xs font-semibold text-[#c2410c]">Ara sınav</span>}
        {statusLabel && <span class="rounded-md bg-paper-2 px-2.5 py-1 text-xs font-semibold text-ink-2">{statusLabel}</span>}
      </div>
      <h1 class="display mt-5 max-w-4xl text-3xl leading-[1.1] text-ink sm:text-4xl md:text-5xl">{week.data.title}</h1>
      <p class="mt-4 max-w-2xl text-lg text-ink-2">{week.data.description}</p>
      {week.data.methods.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Bu haftanın yöntemleri">
          {week.data.methods.map((t) => <li class="chip-mono">{t}</li>)}
        </ul>
      )}
      <p class="mt-5 text-sm text-ink-3"><span class="font-semibold text-ink-2">İzlencedeki başlık:</span> {week.data.topic}</p>
    </div>
  </header>

  <div class="wrap grid gap-12 py-12 lg:grid-cols-[1fr_250px]">
    <article class="prose-lesson min-w-0 max-w-3xl" data-reading-progress>
      {(week.data.changeNote || (s?.note && s.status !== 'normal' && !week.data.exam)) && (
        <aside class="callout callout-warn"><p class="callout-title">Program değişikliği</p><p>{week.data.changeNote || s?.note}</p></aside>
      )}
      {week.data.status === 'taslak' && (
        <aside class="callout callout-note"><p class="callout-title">Hazırlık aşamasında</p><p>Bu haftanın ayrıntılı ders notları henüz yayımlanmadı. Hedefler, temel kavramlar, yöntemler ve uygulama planı izlenceye göre hazırdır; notlar ve defter ders yaklaştıkça eklenecektir.</p></aside>
      )}

      {week.data.objectives.length > 0 && (
        <section aria-labelledby="ogrenme-hedefleri">
          <h2 id="ogrenme-hedefleri" class="!mt-10 !border-0 !pt-0">Öğrenme hedefleri</h2>
          <p>Bu haftanın sonunda:</p>
          <ul class="!list-none !pl-0 !space-y-3">
            {week.data.objectives.map((o, i) => (
              <li class="flex gap-3 rounded-xl border border-line bg-white p-4">
                <span class="grid size-7 shrink-0 place-items-center rounded-md font-mono text-xs font-semibold text-white bg-[var(--mod)]" style={`--mod:${moduleColorVar(m)}`}>{i + 1}</span>
                <span class="text-ink">{o}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      <Content components={{ NotebookEmbed }} />

      {week.data.notebook && week.data.notebook.placement === 'auto' && <NotebookEmbed {...week.data.notebook} />}

      {week.data.datasets.length > 0 && (
        <section>
          <h2 id="veri-setleri">Bu haftanın veri setleri</h2>
          <ul>{week.data.datasets.map((d) => <li>{d.url ? <a href={d.url} rel="noopener" target="_blank">{d.name}</a> : <strong>{d.name}</strong>}{d.note && <span class="text-ink-3"> — {d.note}</span>}</li>)}</ul>
        </section>
      )}
      {week.data.tools.length > 0 && (
        <section>
          <h2 id="araclar">Araçlar ve kütüphaneler</h2>
          <ul class="!list-none !pl-0 flex flex-wrap gap-2">
            {week.data.tools.map((t) => <li class="rounded-lg border border-line bg-white px-3 py-1.5 font-mono text-sm text-ink">{t}</li>)}
          </ul>
        </section>
      )}
      {week.data.resources.length > 0 && (
        <section>
          <h2 id="okuma-listesi">Okuma listesi</h2>
          <ul>{week.data.resources.map((r) => <li>{KIND_LABEL[r.kind] && <span class="chip-mono mr-2">{KIND_LABEL[r.kind]}</span>}<a href={r.url} rel="noopener" target="_blank">{r.title}</a>{r.note && <span class="text-ink-3"> — {r.note}</span>}</li>)}</ul>
        </section>
      )}
      {week.data.tags.length > 0 && (
        <p class="mt-10 flex flex-wrap gap-1.5 text-xs"><span class="mr-1 text-ink-3">Etiketler:</span>{week.data.tags.map((t) => <span class="rounded-md bg-paper-2 px-2 py-0.5 text-ink-2">{t}</span>)}</p>
      )}
      <WeekPager prev={prev} next={next} />
    </article>

    <aside class="hidden lg:block">
      <div class="sticky top-24 space-y-8">
        <Toc headings={headings} extra={tocExtra} />
        <div class="rounded-xl border border-line bg-white p-4 text-sm">
          <p class="eyebrow mb-2">Modül {moduleIndex(m)}</p>
          <p class="font-semibold text-ink">{m.title}</p>
          <p class="mt-1 font-mono text-xs text-ink-3">Hafta {m.weeks[0]}–{m.weeks.at(-1)}</p>
          <a href={href(`/ders-akisi#${m.slug}`)} class="mt-3 inline-block text-xs font-semibold text-brand hover:underline">Modüldeki tüm haftalar →</a>
        </div>
        {outcomes.length > 0 && (
          <div class="rounded-xl border border-line bg-white p-4 text-sm">
            <p class="eyebrow mb-2">Ders kazanımları</p>
            <ul class="space-y-2">
              {outcomes.map((o) => <li class="flex gap-2 text-[13px] leading-snug text-ink-2"><span class="shrink-0 font-mono text-[11px] font-semibold text-brand">{o.id}</span><span>{o.text}</span></li>)}
            </ul>
            <a href={href('/ders-hakkinda#kazanimlar')} class="mt-3 inline-block text-xs font-semibold text-brand hover:underline">Tüm kazanımlar →</a>
          </div>
        )}
      </div>
    </aside>
  </div>
</BaseLayout>
